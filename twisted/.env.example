SECRET_KEY=<insert-super-secure-secret-here>
LOGIN_ENABLED=true # possible options: 'true,false,maybe'

DEBUG=true

POSTGRES_DB = django
POSTGRES_USER = django
POSTGRES_PASSWORD = django
POSTGRES_HOST = localhost
POSTGRES_PORT = 5432

# Set to true if you get error because of no scopes
AUTH_DEBUG = 
HCA_CLIENT_ID =
HCA_CLIENT_SECRET =
HCA_REDIRECT_URI = http://localhost:8000/oauth/callback

HACKATIME_CLIENT_ID =
HACKATIME_CLIENT_SECRET =
HACKATIME_REDIRECT_URI = http://localhost:8000/oauth/hackatime_callback

SLACK_TOKEN = xoxb-***
SLACK_LOG_CHANNEL = C***

# Optional fallback avatar URL, used when a member's Slack profile cannot be fetched.
DEFAULT_PFP =

ALLOWED_HOSTS = 127.0.0.1, localhost
CSRF_TRUSTED_ORIGINS = http://127.0.0.1:8000, http://localhost:8000

R2_ENDPOINT = https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY = <your-access-key>
R2_SECRET_KEY = <your-secret-key>
R2_BUCKET = <your-bucket>
R2_PUBLIC_URL = <your-public-url>
R2_TOKEN = 

# Set true only for local review testing: it skips ARI submission and shows the debug
# review panel. Keep false everywhere else or ships never reach reviewers.
DEBUG_REVIEW=false
ARI_INGEST_ENDPOINT=
ARI_SIGNING_SECRET=
# Must be non-empty for inbound review webhooks; deliveries are rejected (503) without it.
ARI_WEBHOOK_SECRET=